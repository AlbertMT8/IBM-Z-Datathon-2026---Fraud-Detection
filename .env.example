# Copy to ~/fraud/.env on the VM (git-ignored) and replace the placeholder values.
# Read by deploy5.sh (Postgres container) and by the storer / dashboard containers.
POSTGRES_DB=fraud
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change-me
PGHOST=postgres
PGPORT=5432
PGDATABASE=fraud
PGUSER=fraud
PGPASSWORD=change-me
REDIS_URL=redis://redis:6379/0
